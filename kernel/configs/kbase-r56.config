# Mali Kbase - no-Mali ("dummy model") - DDK r56p0
#
# Target kernel : Linux 5.15 LTS (arm64)
# Platform      : Arm FVP guest, Device Tree path
#
# Merge into .config before building, e.g.:
#   make ARCH=arm64 defconfig
#   scripts/kconfig/merge_config.sh -m -O . .config kernel/configs/kbase-r56.config
#   make ARCH=arm64 olddefconfig
#
# r56p0 ships its own fragments under
#   driver/product/kernel/config/fragment/
# (nomali.fragment, mali_expert_no_mali.fragment, midgard.fragment,
#  base.fragment, platform/vexpress.fragment, ...).
# This file is the flattened, self-contained equivalent for this lab and follows
# the official "Configuring the Linux Kernel for Mali" virtual-device recipe.

CONFIG_MALI_MIDGARD=m
CONFIG_MALI_CSF_SUPPORT=y
CONFIG_MALI_EXPERT=y

# "Mali HW backend" -> "Enable build of Mali kernel driver for No Mali"
CONFIG_MALI_NO_MALI=y
# CONFIG_MALI_REAL_HW is not set

# Dummy-model GPU identity. r56p0's Kconfig default is "tMIx"; the official
# G725/G925 virtual-device recipe uses "tKRx", which this release also supports.
CONFIG_MALI_NO_MALI_DEFAULT_GPU="tKRx"

# Device Tree integration (Arm virtual platforms).
CONFIG_MALI_PLATFORM_NAME="devicetree"

# Optional r56p0 extras (see driver/product/kernel/config/fragment/):
#   CONFIG_MALI_BASE_MODULES=y
#   CONFIG_MALI_MEMORY_GROUP_MANAGER=y
# Not required by the virtual-device recipe, so left disabled here.
