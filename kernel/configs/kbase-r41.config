# Mali Kbase - no-Mali ("dummy model") - DDK r41p0
#
# Target kernel : Linux 5.15 LTS (arm64)
# Platform      : Arm FVP guest, Device Tree path
#
# Merge into .config before building, e.g.:
#   make ARCH=arm64 defconfig
#   scripts/kconfig/merge_config.sh -m -O . .config kernel/configs/kbase-r41.config
#   make ARCH=arm64 olddefconfig
#
# Options follow the official "Configuring the Linux Kernel for Mali" recipe from
# the Arm GPU bug bounty virtual-platform how-to guide (Device Drivers ->
# Graphics Support -> ARM GPU Configuration).

CONFIG_MALI_MIDGARD=m
CONFIG_MALI_CSF_SUPPORT=y
CONFIG_MALI_EXPERT=y

# "Mali HW backend" -> "Enable build of Mali kernel driver for No Mali"
CONFIG_MALI_NO_MALI=y
# CONFIG_MALI_REAL_HW is not set

# r41p0 has no CONFIG_MALI_NO_MALI_DEFAULT_GPU Kconfig option; the dummy model
# id is hardcoded to "tMIx" in backend/gpu/mali_kbase_model_dummy.c.

# Device Tree integration (Arm virtual platforms).
CONFIG_MALI_PLATFORM_NAME="devicetree"

# CONFIG_LARGE_PAGE_SUPPORT is selected by the driver by default.
